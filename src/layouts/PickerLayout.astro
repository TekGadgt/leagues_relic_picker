---
import BaseLayout from "./BaseLayout.astro";
import Navbar from "../components/Navbar.astro";
import DetailSidebar from "../components/DetailSidebar.astro";
import ExportButton from "../components/ExportButton.astro";

interface Props {
  meta: {
    title: string;
    description: string;
    ogImage: string;
    ogImageAlt: string;
    url: string;
  };
  themeKey: string;
  exportFilename: string;
  pageType: 'relics' | 'masteries' | 'pacts' | 'blessings' | 'regions';
  derivedGroups?: { group: string; from: string[] }[];
  randomizer?: string;
  shareImage?: boolean;
  regionRules?: {
    starting: string[];
    forced: { region: string; slot: number; tasks: number }[];
    choices: { slot: number; tasks: number }[];
  };
}

const { meta, themeKey, exportFilename, pageType, derivedGroups = [], randomizer, shareImage, regionRules } = Astro.props;

// Relics and blessings activate one choice per tier. Masteries are cumulative
// and pacts form a graph, so neither is constrained this way.
const onePickPerTier = pageType === 'relics' || pageType === 'blessings';
---

<BaseLayout
  title={meta.title}
  description={meta.description}
  ogImage={meta.ogImage}
  ogImageAlt={meta.ogImageAlt}
  ogUrl={meta.url}
  themeKey={themeKey}
>
  <Navbar itemType={pageType} showShowcaseLink={true} />

  <main id="main" data-page-type={pageType}>
    <h1 class="title" contenteditable="true">Change Me</h1>
    <slot />
  </main>

  <ExportButton
    showPactCounter={pageType === 'pacts'}
    showRandomizer={Boolean(randomizer)}
    showShareImage={Boolean(shareImage)}
    randomizerNoun={pageType === 'regions' ? 'Region' : 'Tier'}
  />
  <DetailSidebar />

  <script is:inline define:vars={{ exportFilename, derivedGroups, onePickPerTier, randomizer, shareImage, pageType, regionRules }}>
    window.PICKER_CONFIG = {
      exportFilename,
      derivedGroups,
      onePickPerTier,
      randomizer,
      shareImage,
      pageType,
      regionRules,
    };
  </script>
  <script src="../scripts/picker.ts"></script>
  <script src="../scripts/pact-graph.ts"></script>
  <script src="../scripts/blessings.ts"></script>
  <script src="../scripts/region-rail.ts"></script>
</BaseLayout>
