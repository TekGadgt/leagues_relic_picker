---
interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  ogImageAlt?: string;
  ogUrl?: string;
  bodyClass?: string;
  enableThemeScript?: boolean;
  themeKey?: string;
}

const {
  title,
  description = "All Previous and Current OSRS/RS3 Leagues Relic Pickers",
  ogImage = "/poster.png",
  ogImageAlt = "Leagues Relic Picker",
  ogUrl = "https://relics.runetools.lol",
  bodyClass = "",
  enableThemeScript = false,
  themeKey,
} = Astro.props;

const site = Astro.site || 'https://relics.runetools.lol';
const sitemapUrl = new URL("/sitemap-index.xml", site).href;
---

<!doctype html>
<html lang="en" data-theme={themeKey}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    {enableThemeScript && (
      <script is:inline>
        // Apply the saved theme before first paint to prevent flicker.
        // No saved key (or an unknown one) leaves data-theme unset, which
        // matches no themes.css block and falls through to the CSS-level
        // :where(:root) default — so the default lives in exactly one place.
        var saved = localStorage.getItem('selectedTheme');
        if (saved) document.documentElement.dataset.theme = saved;
      </script>
    )}
    <title>{title}</title>
    <meta property="og:type" content="website" />
    <meta property="og:url" content={ogUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={ogImageAlt} />
    <link rel="sitemap" type="application/xml" href={sitemapUrl} />
    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <slot />
    <script
      is:inline
      defer
      src="https://static.cloudflareinsights.com/beacon.min.js"
      data-cf-beacon='{"token": "a488248dbb94443d840feb6ed005bc1b"}'></script>
  </body>
</html>

<style is:global>
  @import "../styles/global.css";
</style>
