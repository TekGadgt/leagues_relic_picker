---
interface Props {
  id: string;
  src: string;
  label: string;
  toolTipItems: (string | string[])[];
  path?: 'chaos' | 'order' | 'balance';
  derived?: boolean;
}

const { id, src, label, toolTipItems, path, derived = false } = Astro.props;
---

<div
  class:list={['mastery', { derived }]}
  id={id}
  data-label={label}
  data-image-src={src}
  data-items={JSON.stringify(toolTipItems)}
  data-path={path}
  data-derived={derived ? 'true' : undefined}
>
  <img class="masteryImg" src={src} alt={`${label} mastery icon`} />
  <span class="masteryLabel">{label}</span>
</div>
