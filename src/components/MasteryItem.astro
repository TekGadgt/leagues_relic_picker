---
interface Props {
  id: string;
  src: string;
  label: string;
  toolTipItems: (string | string[])[];
  grantsBonusPick?: boolean;
  path?: 'chaos' | 'order' | 'balance';
  derived?: boolean;
  game?: 'osrs' | 'rs3';
}

const { id, src, label, toolTipItems, path, derived = false, game = 'osrs', grantsBonusPick } = Astro.props;
---

<div
  class:list={['mastery', { derived }]}
  id={id}
  data-label={label}
  data-image-src={src}
  data-items={JSON.stringify(toolTipItems)}
  data-grants-bonus-pick={grantsBonusPick ? 'true' : undefined}
  data-path={path}
  data-derived={derived ? 'true' : undefined}
>
  <img
    class:list={["masteryImg", { rs3: game === 'rs3' }]}
    src={src}
    alt={`${label} mastery icon`}
  />
  <span class="masteryLabel">{label}</span>
</div>
